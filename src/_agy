# Zsh completion for Google Antigravity CLI (agy / antigravity)
# Homepage: https://antigravity.google/docs/cli/reference

_agy_bin() {
  local cmd="${(Q)words[1]:-agy}"
  if [[ "$cmd" == */* && -x "$cmd" ]]; then
    print -r -- "$cmd"
  elif (( $+commands[$cmd] )); then
    print -r -- "${commands[$cmd]}"
  elif (( $+commands[agy] )); then
    print -r -- "${commands[agy]}"
  elif (( $+commands[antigravity] )); then
    print -r -- "${commands[antigravity]}"
  else
    print -r -- "agy"
  fi
}

_agy_cache_dir() {
  local dir=""
  zstyle -s ":completion:${curcontext}:" cache-path dir 2>/dev/null || true
  if [[ -z "$dir" ]]; then
    dir="${ZSH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/agy}"
  fi
  [[ -d "$dir" ]] || command mkdir -p "$dir" 2>/dev/null
  print -r -- "$dir"
}

# Refresh dynamic CLI help cache only when the underlying binary changes.
_agy_refresh_help_cache() {
  emulate -L zsh
  setopt localoptions extendedglob

  local bin="$1" cache_file="$2"
  [[ -x "$bin" ]] || return 1

  local real_bin="${bin:A}"
  local -A st
  local mtime="0"
  if zmodload -F zsh/stat b:zstat 2>/dev/null && zstat -H st -- "$real_bin" 2>/dev/null; then
    mtime="${st[mtime]:-0}:${st[size]:-0}"
  fi
  local stamp="# stamp: ${real_bin}:${mtime}"

  if [[ -r "$cache_file" ]]; then
    local first_line
    IFS= read -r first_line < "$cache_file"
    if [[ "$first_line" == "$stamp" ]]; then
      return 0
    fi
  fi

  local help_out
  help_out="$("$bin" --help 2>&1)" || return 1
  [[ "$help_out" == *"Usage of "* ]] || return 1

  local -a out_lines=("$stamp")
  local section="flags" line flag desc sub
  for line in "${(@f)help_out}"; do
    line="${line%$'\r'}"
    if [[ "$line" == "Available subcommands:"* ]]; then
      section="subcommands"
      continue
    fi
    if [[ "$section" == "flags" ]]; then
      if [[ "$line" =~ '^[[:space:]]+(--[A-Za-z0-9_-]+)[[:space:]]+(.*)$' ]]; then
        flag="${match[1]}"
        desc="${match[2]}"
        desc="${desc//\[/(}"
        desc="${desc//\]/)}"
        out_lines+=("FLAG	${flag}	${desc}")
      fi
    elif [[ "$section" == "subcommands" ]]; then
      if [[ "$line" =~ '^[[:space:]]+([A-Za-z0-9_-]+)[[:space:]]+(.*)$' ]]; then
        sub="${match[1]}"
        desc="${match[2]}"
        out_lines+=("SUB	${sub}	${desc}")
      fi
    fi
  done

  local tmp_file="${cache_file}.tmp.$$"
  if print -rl -- "${out_lines[@]}" >| "$tmp_file" 2>/dev/null; then
    command mv -f "$tmp_file" "$cache_file" 2>/dev/null
  else
    command rm -f "$tmp_file" 2>/dev/null
  fi
}

# Complete model IDs (instant baseline + non-blocking background refresh of `agy models`).
_agy_models() {
  local -a models
  local -A seen

  local -a builtin_models=(
    'gemini-4-carbon-high:Gemini 4 Carbon (High)'
    'gemini-4-carbon-medium:Gemini 4 Carbon (Medium)'
    'gemini-4-carbon-low:Gemini 4 Carbon (Low)'
    'gemini-4-hydrogen-xhigh:Gemini 4 Hydrogen (XHigh)'
    'gemini-4-hydrogen-high:Gemini 4 Hydrogen (High)'
    'gemini-4-hydrogen-medium:Gemini 4 Hydrogen (Medium)'
    'gemini-4-hydrogen-low:Gemini 4 Hydrogen (Low)'
    'gemini-4-argon-high:Gemini 4 Argon (High)'
    'gemini-4-argon-medium:Gemini 4 Argon (Medium)'
    'gemini-4-argon-low:Gemini 4 Argon (Low)'
    'gemini-3.8-flash-high:Gemini 3.8 Flash (High)'
    'gemini-3.8-flash-medium:Gemini 3.8 Flash (Medium)'
    'gemini-3.8-flash-low:Gemini 3.8 Flash (Low)'
    'gemini-pro-orchestrator:Orchestrator (Carbon)'
    'gemini-pro-orchestrator-argon:Orchestrator (Argon)'
    'claude-opus-5-5-high:Claude Opus 5.5 (High)'
    'claude-opus-5-5-medium:Claude Opus 5.5 (Medium)'
    'claude-opus-5-5-low:Claude Opus 5.5 (Low)'
    'claude-sonnet-5-5-high:Claude Sonnet 5.5 (High)'
    'claude-sonnet-5-5-medium:Claude Sonnet 5.5 (Medium)'
    'claude-sonnet-5-5-low:Claude Sonnet 5.5 (Low)'
    'gpt-oss-120b-medium:GPT-OSS 120B (Medium)'
  )

  local entry key
  for entry in "${builtin_models[@]}"; do
    key="${entry%%:*}"
    seen[$key]=1
    models+=("$entry")
  done

  local cache_dir="$(_agy_cache_dir)"
  local cache_file="${cache_dir}/agy-models.cache"
  local bin="$(_agy_bin)"

  if [[ -r "$cache_file" ]]; then
    local line id desc
    for line in "${(@f)$(<"$cache_file")}"; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      id="${line%%	*}"
      desc="${line#*	}"
      [[ "$desc" == "$line" ]] && desc="Available model"
      if [[ -n "$id" ]] && (( ! $+seen[$id] )); then
        seen[$id]=1
        models+=("${id//:/\\:}:${desc}")
      fi
    done
  fi

  # Refresh asynchronously in the background if missing or older than 24h.
  local -a fresh_cache=("$cache_file"(Nm-1))
  if (( ${#fresh_cache} == 0 )) && [[ -x "$bin" ]]; then
    () {
      emulate -L zsh
      setopt localoptions nomonitor nonotify nobgnice extendedglob
      (
        local raw line in_list=0 m_id m_desc
        local -a parsed=()
        raw="$("$bin" models 2>&1)" || exit 0
        for line in "${(@f)raw}"; do
          line="${line%$'\r'}"
          if [[ "$line" == "Available models:"* ]]; then
            in_list=1
            continue
          fi
          (( in_list )) || continue
          line="${line#"${line%%[![:space:]]*}"}"
          line="${line%"${line##*[![:space:]]}"}"
          [[ -z "$line" || "$line" == (Error:|E[0-9][0-9][0-9][0-9]|I[0-9][0-9][0-9][0-9])* ]] && continue
          if [[ "$line" =~ '^([A-Za-z0-9._@-]+)[[:space:]]+[-—:(]*(.*)$' ]]; then
            m_id="${match[1]}"
            m_desc="${match[2]%\)}"
            parsed+=("${m_id}	${m_desc:-Available model}")
          elif [[ "$line" =~ '^([A-Za-z0-9._@-]+)$' ]]; then
            parsed+=("${match[1]}	Available model")
          fi
        done
        if (( ${#parsed} > 0 )); then
          local tmp="${cache_file}.tmp.$$"
          print -rl -- "${parsed[@]}" >| "$tmp" 2>/dev/null && command mv -f "$tmp" "$cache_file" 2>/dev/null
        fi
      ) >/dev/null 2>&1 &!
    } 2>/dev/null
  fi

  _describe -t models 'model' models
}

# Extract YAML frontmatter name/description from an agent markdown file.
_agy_parse_agent_md() {
  emulate -L zsh
  local file="$1"
  [[ -r "$file" ]] || return 1

  local a_name="${file:t:r}" a_desc="" line i=0 in_fm=0
  while (( i < 25 )) && IFS= read -r line; do
    (( i++ ))
    line="${line%$'\r'}"
    if (( i == 1 )); then
      [[ "$line" == "---" ]] || break
      in_fm=1
      continue
    fi
    [[ "$line" == "---" ]] && break
    if (( in_fm )); then
      if [[ "$line" =~ '^name:[[:space:]]*["'\'']?([^"'\'']+)["'\'']?[[:space:]]*$' ]]; then
        a_name="${match[1]}"
      elif [[ "$line" =~ '^description:[[:space:]]*["'\'']?([^"'\''>|-].*)["'\'']?[[:space:]]*$' ]]; then
        a_desc="${match[1]}"
      fi
    fi
  done < "$file"

  REPLY="${a_name//:/\\:}:${a_desc:-Custom agent}"
}

# Complete available session/ACP agents (built-in + workspace + global + cached).
_agy_agents() {
  local -a agents
  local -A seen

  local -a builtin_agents=(
    'self:Default agent inheriting full session configuration'
    'research:Read-only codebase exploration and research agent'
    'image-generator:Image generation and editing agent'
  )

  local entry key REPLY
  for entry in "${builtin_agents[@]}"; do
    key="${entry%%:*}"
    seen[$key]=1
    agents+=("$entry")
  done

  () {
    emulate -L zsh
    setopt localoptions extendedglob nullglob

    local dir="$PWD" f
    local -a md_files=()
    while true; do
      md_files+=(
        "$dir"/(.agents|.agent|_agents|_agent)/agents/*.md(.N)
        "$dir"/(.agents|.agent|_agents|_agent)/plugins/*/agents/*.md(.N)
        "$dir"/.claude/agents/*.md(.N)
      )
      [[ "$dir" == "/" || -z "$dir" ]] && break
      dir="${dir:h}"
    done

    md_files+=(
      "$HOME/.gemini/config/agents/"*.md(.N)
      "$HOME/.gemini/config/plugins/"*/agents/*.md(.N)
      "$HOME/.gemini/agents/"*.md(.N)
    )

    for f in "${md_files[@]}"; do
      if _agy_parse_agent_md "$f"; then
        key="${REPLY%%:*}"
        if (( ! $+seen[$key] )); then
          seen[$key]=1
          agents+=("$REPLY")
        fi
      fi
    done
  }

  local cache_dir="$(_agy_cache_dir)"
  local cache_file="${cache_dir}/agy-agents.cache"
  local bin="$(_agy_bin)"

  if [[ -r "$cache_file" ]]; then
    local line
    for line in "${(@f)$(<"$cache_file")}"; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      if (( ! $+seen[$line] )); then
        seen[$line]=1
        agents+=("${line//:/\\:}:Custom agent")
      fi
    done
  fi

  local -a fresh_cache=("$cache_file"(Nm-1))
  if (( ${#fresh_cache} == 0 )) && [[ -x "$bin" ]]; then
    () {
      emulate -L zsh
      setopt localoptions nomonitor nonotify nobgnice
      (
        local raw line in_list=0
        local -a parsed=()
        raw="$("$bin" agents 2>&1)" || exit 0
        for line in "${(@f)raw}"; do
          line="${line%$'\r'}"
          if [[ "$line" == "Available agents:"* ]]; then
            in_list=1
            continue
          fi
          (( in_list )) || continue
          line="${line#"${line%%[![:space:]]*}"}"
          line="${line%"${line##*[![:space:]]}"}"
          [[ -n "$line" && "$line" != (Error:|E[0-9][0-9][0-9][0-9]|I[0-9][0-9][0-9][0-9])* ]] && parsed+=("$line")
        done
        local tmp="${cache_file}.tmp.$$"
        print -rl -- "# agents" "${parsed[@]}" >| "$tmp" 2>/dev/null && command mv -f "$tmp" "$cache_file" 2>/dev/null
      ) >/dev/null 2>&1 &!
    } 2>/dev/null
  fi

  _describe -t agents 'agent' agents
}

# Complete recent conversation IDs from ~/.gemini/antigravity-cli/brain (newest first).
_agy_conversations() {
  local brain_dir="$HOME/.gemini/antigravity-cli/brain"
  [[ -d "$brain_dir" ]] || return 1

  local -a convs=() dirs=()
  () {
    emulate -L zsh
    setopt localoptions extendedglob nullglob

    local -A seen_dirs
    local -a pref_dirs=() recent_dirs=()
    if [[ -n "$PREFIX" ]]; then
      pref_dirs=("$brain_dir/${PREFIX}"*(-/Nom[1,60]))
    fi
    recent_dirs=("$brain_dir/"*(-/Nom[1,60]))

    local d
    for d in "${pref_dirs[@]}" "${recent_dirs[@]}"; do
      if (( ! $+seen_dirs[$d] )); then
        seen_dirs[$d]=1
        dirs+=("$d")
      fi
    done
  }
  (( ${#dirs} )) || return 1

  local has_stat=0 has_dt=0
  zmodload -F zsh/stat b:zstat 2>/dev/null && has_stat=1
  zmodload zsh/datetime 2>/dev/null && has_dt=1

  local d id ts label
  local -A st
  for d in "${dirs[@]}"; do
    id="${d:t}"
    [[ "$id" == .* ]] && continue
    label="Conversation"
    if (( has_stat && has_dt )) && zstat -H st -- "$d" 2>/dev/null; then
      strftime -s ts '%Y-%m-%d %H:%M' "${st[mtime]}" 2>/dev/null && label="Last active ${ts}"
    fi
    convs+=("${id//:/\\:}:${label}")
  done

  (( ${#convs} )) && _describe -V -t conversations 'conversation ID' convs
}

# Complete configured MCP server names via `agy mcp list`.
_agy_mcp_servers() {
  local want_status="${1:-all}"
  local bin="$(_agy_bin)"
  local out
  out="$("$bin" mcp list 2>/dev/null)" || return 1

  local -a preferred fallback
  local line name mtype mstatus rest
  for line in "${(@f)out}"; do
    line="${line%$'\r'}"
    [[ -z "$line" || "$line" == NAME[[:space:]]* || "$line" == "No "* ]] && continue
    if [[ "$line" =~ '^([^[:space:]]+)[[:space:]]+([^[:space:]]+)[[:space:]]+([^[:space:]]+)[[:space:]]+(.*)$' ]]; then
      name="${match[1]}"
      mtype="${match[2]}"
      mstatus="${match[3]}"
      rest="${match[4]}"
      local spec="${name//:/\\:}:${mtype} (${mstatus}) — ${rest}"
      fallback+=("$spec")
      if [[ "$want_status" == "all" || "$mstatus" == "$want_status" ]]; then
        preferred+=("$spec")
      fi
    fi
  done

  if (( ${#preferred} )); then
    _describe -t mcp-servers 'MCP server' preferred
  elif (( ${#fallback} )); then
    _describe -t mcp-servers 'MCP server' fallback
  else
    return 1
  fi
}

# Complete `<commandOrUrl> [args...]` for `agy mcp add`.
_agy_mcp_cmd_or_args() {
  if (( CURRENT == 1 )); then
    _alternative \
      'commands:executable:_command_names -e' \
      'urls:HTTP URL:_urls'
  else
    _normal
  fi
}

# Complete installed plugin names via `agy plugin list` (with filesystem fallback).
_agy_plugins() {
  local want_status="${1:-all}"
  local bin="$(_agy_bin)"
  local out
  out="$("$bin" plugin list 2>/dev/null)"

  local -a preferred fallback
  local line name pstatus
  for line in "${(@f)out}"; do
    line="${line%$'\r'}"
    if [[ "$line" =~ '^-[[:space:]]+([^[:space:]]+)[[:space:]]+\(([^)]+)\)' ]]; then
      name="${match[1]}"
      pstatus="${match[2]}"
      local spec="${name//:/\\:}:${pstatus} plugin"
      fallback+=("$spec")
      if [[ "$want_status" == "all" || "$pstatus" == "$want_status" ]]; then
        preferred+=("$spec")
      fi
    fi
  done

  if (( ${#fallback} == 0 )); then
    local -a dirs=("$HOME/.gemini/config/plugins/"*(/N:t))
    for name in "${dirs[@]}"; do
      preferred+=("${name//:/\\:}:installed plugin")
    done
  fi

  if (( ${#preferred} )); then
    _describe -t plugins 'plugin' preferred
  elif (( ${#fallback} )); then
    _describe -t plugins 'plugin' fallback
  else
    return 1
  fi
}

