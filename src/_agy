    '(--agent)--agent=[Agent for the ACP session]:agent:_agy_agents'
    '(--app-data-dir --app_data_dir)--app-data-dir=[Path where application data is stored]:directory:_directories'
    '!--app_data_dir=[Path where application data is stored]:directory:_directories'
    '(--dangerously-skip-permissions)--dangerously-skip-permissions[Auto-approve all tool permission requests]'
    '(--disable-telemetry --disable_telemetry)--disable-telemetry[Disable telemetry]'
