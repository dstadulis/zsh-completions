  )

  # Expose non-duplicate internal ACP flags when typed or when complete-all is set.
  if [[ "$PREFIX$SUFFIX" == --(*_*|worker*) ]] || zstyle -t ":completion:${curcontext}:" complete-all; then
    args+=(
      '(--cli_dir_name)--cli_dir_name=[Subdirectory under app_data_dir for CLI settings and logs]:directory name:'
      '(--log-file --cli_log_file)--cli_log_file=[Override ACP log file path]:log file:_files'
