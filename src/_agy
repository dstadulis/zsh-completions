      '(--override_user_agent_name)--override_user_agent_name=[Override user agent name for HTTP requests]:user agent:'
      '(--use_stubby_auth)--use_stubby_auth[Use LOAS auth]'
      '(--worker)--worker[Serve a single session for an ACP front process (internal)]'
    )
  fi

  _arguments -S : "${args[@]}"
}

_agy_mcp() {
  local context state state_descr line
  typeset -A opt_args
  local ret=1

  local -a mcp_subcommands=(
    'add:Add or update an MCP server configuration'
    'remove:Remove an MCP server configuration'
    'list:List all configured MCP servers'
    'enable:Enable an MCP server'
    'disable:Disable an MCP server'
  )

  _arguments -S -C : \
    '(-h --help : * -)'{-h,--help}'[Show help]' \
    '1:mcp subcommand:->subcmd' \
    '*::arg:->args' && ret=0

  case "$state" in
    subcmd)
      _describe -t subcommands 'mcp subcommand' mcp_subcommands && ret=0
      ;;
    args)
      curcontext="${curcontext%:*:*}:agy-mcp-${line[1]}:"
      case "${line[1]}" in
        add)
          # Flags must precede <name> in `agy mcp add`.
          _arguments -S -A "-*" : \
            '*-H=[HTTP header "Key: Value" (repeatable)]:HTTP header:' \
            '*--header=[HTTP header "Key: Value" (repeatable)]:HTTP header:' \
            '*-e=[Environment variable KEY=value (repeatable)]:KEY=value:' \
            '*--env=[Environment variable KEY=value (repeatable)]:KEY=value:' \
            '(-t --type)'{-t,--type}'=[MCP server transport type]:server type:((
              stdio\:"Local stdio executable server (default)"
              http\:"Remote Streamable HTTP server"
            ))' \
            '(: * -)'{-h,--help}'[Show help]' \
            '1:server name:' \
            '*:::command or URL:_agy_mcp_cmd_or_args' && ret=0
          ;;
        remove)
          _arguments -S : \
            '(: * -)'{-h,--help}'[Show help]' \
            '1:MCP server:_agy_mcp_servers all' && ret=0
          ;;
        list)
          _arguments -S : \
            '(: * -)'{-h,--help}'[Show help]' && ret=0
          ;;
        enable)
          _arguments -S : \
            '(: * -)'{-h,--help}'[Show help]' \
            '1:MCP server:_agy_mcp_servers disabled' && ret=0
          ;;
        disable)
          _arguments -S : \
            '(: * -)'{-h,--help}'[Show help]' \
            '1:MCP server:_agy_mcp_servers enabled' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_agy_plugin() {
  local context state state_descr line
  typeset -A opt_args
  local ret=1

  local -a plugin_subcommands=(
    'list:List installed plugins'
    'import:Import plugins from gemini, claude, or a directory'
    'install:Install a plugin directory or plugin@marketplace target'
    'uninstall:Uninstall an installed plugin'
    'enable:Enable an installed plugin'
    'disable:Disable an installed plugin'
    'validate:Validate a plugin manifest and directory structure'
    'link:Generate a link to a plugin marketplace'
    'help:Show plugin command help'
  )

  _arguments -S -C : \
    '(-h --help : * -)'{-h,--help}'[Show help]' \
    '1:plugin command:->subcmd' \
    '*::arg:->args' && ret=0

  case "$state" in
    subcmd)
      _describe -t subcommands 'plugin command' plugin_subcommands && ret=0
      ;;
    args)
      curcontext="${curcontext%:*:*}:agy-plugin-${line[1]}:"
      case "${line[1]}" in
        list)
          _arguments -S : \
            '(--json)--json[Output installed plugins as JSON]' && ret=0
          ;;
        import)
          _arguments -S : \
            '1:import source or path:_agy_plugin_import_target' && ret=0
          ;;
        install)
          _arguments -S : \
            '1:plugin directory or target:_directories' && ret=0
          ;;
        uninstall)
          _arguments -S : \
            '1:installed plugin:_agy_plugins all' && ret=0
          ;;
        enable)
          _arguments -S : \
            '1:installed plugin:_agy_plugins disabled' && ret=0
          ;;
        disable)
          _arguments -S : \
            '1:installed plugin:_agy_plugins enabled' && ret=0
          ;;
        validate)
          _arguments -S : \
            '(--strict)--strict[Also fail on warnings]' \
            '(--json)--json[Print validation report as JSON]' \
            '(: * -)'{-h,--help}'[Show help]' \
            '1:plugin directory or plugin.json:_files' && ret=0
          ;;
        link)
          _arguments -S : \
            '1:marketplace name:' \
            '2:target directory:_directories' && ret=0
          ;;
        help)
          _message 'no arguments' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

