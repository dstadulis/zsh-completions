_agy() {
  local context state state_descr line
  typeset -A opt_args
  local ret=1

  local -a subcommands=(
    'acp:Start the Agent Client Protocol (ACP) stdio server'
    'agent:List available agents'
    'agents:List available agents'
    'changelog:Show changelog and release notes'
    'help:Show help for subcommands'
    'install:Configure environment paths and shell settings'
    'mcp:Manage MCP servers (add, remove, list, enable, disable)'
    'mic-serve:Serve this machine'\''s microphone to a CLI on another host'
    'models:List available models'
    'plugin:Manage plugins (install, uninstall, list, enable, disable)'
    'plugins:Manage plugins (alias for plugin)'
    'remote-control:Manage the remote-control background daemon'
    'update:Update CLI'
  )

  local -a main_opts=(
    '(1)*--add-dir=[Add a directory to the workspace (repeatable)]:directory:_directories'
    '(1 --agent)--agent=[Agent for the current CLI session]:agent:_agy_agents'
    '(1 -c --continue --conversation --new-project)'{-c,--continue}'[Continue the most recent conversation]'
    '(1 -c --continue --conversation --new-project)--conversation=[Resume a previous conversation by ID]:conversation ID:_agy_conversations'
    '(--dangerously-skip-permissions)--dangerously-skip-permissions[Auto-approve all tool permission requests without prompting]'
    '(1 --disable-slash-commands)--disable-slash-commands[Disable slash command and skill expansion in print mode]'
    '(1 --effort)--effort=[Reasoning effort for the current CLI session]:effort:((
      low\:"Fastest responses with minimal thinking"
      medium\:"Balanced speed and reasoning"
      high\:"Deep reasoning for complex tasks"
      xhigh\:"Extended reasoning effort"
      max\:"Maximum reasoning depth"
    ))'
    '(: * -)'{-h,--help}'[Show help]'
    '(1 -i --prompt-interactive -p --print --prompt)'{-i,--prompt-interactive}'=[Run an initial prompt interactively and continue the session]:prompt:'
    '(1 --input-format)--input-format=[Input format for print mode]:input format:((
      text\:"Plain text prompt input (default)"
      stream-json\:"Read one NDJSON message per line from stdin (requires --output-format stream-json)"
    ))'
    '(1 --json-schema)--json-schema=[JSON schema string or path to schema file for structured output]:JSON schema or file:_files'
    '(--log-file)--log-file=[Override CLI log file path]:log file:_files'
    '(1 --mode)--mode=[Set the agent execution mode for this session]:execution mode:((
      accept-edits\:"Automatically accept file edits"
      auto\:"Autonomous execution mode"
      plan\:"Plan before making changes"
    ))'
    '(1 --model)--model=[Model for the current CLI session]:model:_agy_models'
    '(1 -c --continue --conversation --new-project)--new-project[Create a new project for this session]'
    '(1 --output-format)--output-format=[Output format for print mode]:output format:((
      text\:"Human-readable plain text output (default)"
      json\:"Structured JSON result object"
      stream-json\:"Streaming NDJSON events"
    ))'
    '(1 -p --print --prompt -i --prompt-interactive)'{-p,--print,--prompt}'=[Run a single prompt non-interactively and print the response]:prompt:'
    '(1 --print-timeout)--print-timeout=[Time limit for print mode (0s waits until turn completes)]:duration:((
      0s\:"Wait until the turn completes (default)"
      30s\:"30 second timeout"
      1m\:"1 minute timeout"
      5m\:"5 minute timeout"
      10m\:"10 minute timeout"
      30m\:"30 minute timeout"
      1h\:"1 hour timeout"
    ))'
    '(1 --project)--project=[Project ID or project name for the current CLI session]:project ID or name:'
    '(1 --remote-agent)--remote-agent[Run conversations using remote agents]'
    '(1 --remote-control)--remote-control[Create a remote connection for the CLI session on start up]'
    '(--sandbox)--sandbox[Run in a sandbox with terminal restrictions enabled]'
    '(1 --settings)--settings=[Session-only settings JSON object or path to settings file]:settings JSON or file:_files'
    '(: * -)--version[Show CLI version]'
  )

  # Merge any newly introduced flags or subcommands from `agy --help` (cached by binary mtime).
  local -A known_flags=(
    [--add-dir]=1 [--agent]=1 [--continue]=1 [--conversation]=1
    [--dangerously-skip-permissions]=1 [--disable-slash-commands]=1
    [--effort]=1 [--help]=1 [--input-format]=1 [--json-schema]=1
    [--log-file]=1 [--mode]=1 [--model]=1 [--new-project]=1
    [--output-format]=1 [--print]=1 [--print-timeout]=1 [--project]=1
    [--prompt]=1 [--prompt-interactive]=1 [--remote-agent]=1
    [--remote-control]=1 [--sandbox]=1 [--settings]=1 [--version]=1
  )
  local -A known_subs=(
    [acp]=1 [agent]=1 [agents]=1 [changelog]=1 [help]=1 [install]=1
    [mcp]=1 [mic-serve]=1 [models]=1 [plugin]=1 [plugins]=1
    [remote-control]=1 [update]=1
  )

  local bin="$(_agy_bin)"
  local cache_file="$(_agy_cache_dir)/agy-help.cache"
  if _agy_refresh_help_cache "$bin" "$cache_file" && [[ -r "$cache_file" ]]; then
    local cline kind item desc
    for cline in "${(@f)$(<"$cache_file")}"; do
      [[ "$cline" == \#* || -z "$cline" ]] && continue
      kind="${cline%%	*}"
      cline="${cline#*	}"
      item="${cline%%	*}"
      desc="${cline#*	}"
      if [[ "$kind" == "FLAG" ]] && (( ! $+known_flags[$item] )); then
        known_flags[$item]=1
        main_opts+=("(${item})${item}[${desc}]")
      elif [[ "$kind" == "SUB" ]] && (( ! $+known_subs[$item] )); then
        known_subs[$item]=1
        subcommands+=("${item//:/\\:}:${desc}")
      fi
    done
  fi

  _arguments -S -C : \
    "${main_opts[@]}" \
    '1:subcommand:->subcmd' \
    '*::arg:->args' && ret=0

  case "$state" in
    subcmd)
      _describe -t subcommands 'subcommand' subcommands && ret=0
      ;;
    args)
      curcontext="${curcontext%:*:*}:agy-${line[1]}:"
      case "${line[1]}" in
        acp)
          _agy_acp && ret=0
          ;;
        agent|agents|changelog|models)
          _arguments -S : \
            '(: * -)'{-h,--help}'[Show help]' && ret=0
          ;;
        help)
          local -a help_targets=("${subcommands[@]:#help:*}")
          _arguments -S : \
            '1:subcommand:->help_target' && ret=0
          if [[ "$state" == "help_target" ]]; then
            _describe -t subcommands 'subcommand' help_targets && ret=0
          fi
          ;;
        install)
          _arguments -S : \
            '(--dir)--dir=[Custom directory target to configure PATH for]:directory:_directories' \
            '(--skip-aliases)--skip-aliases[Bypass shell profile alias purging]' \
            '(--skip-path)--skip-path[Bypass shell profile PATH appending]' \
            '(: * -)'{-h,--help}'[Show help]' && ret=0
          ;;
        mcp)
          _agy_mcp && ret=0
          ;;
        mic-serve)
          _arguments -S : \
            '(--addr)--addr=[Loopback address to listen on]:listen address:_agy_mic_serve_addr' \
            '(: * -)'{-h,--help}'[Show help]' && ret=0
          ;;
        plugin|plugins)
          _agy_plugin && ret=0
          ;;
        remote-control)
          _agy_remote_control && ret=0
          ;;
        update)
          _arguments -S : \
            '(: * -)--help[Show help]' && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

if (( $+words )); then
  _agy "$@"
elif (( $+functions[compdef] )); then
  compdef _agy agy antigravity
fi
