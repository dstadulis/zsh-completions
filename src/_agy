    '!--gemini_dir=[Path where Gemini files are stored]:directory:_directories'
    '(: * -)'{-h,--help}'[Show help]'
    '(--ide-mcp-port --ide_mcp_port)--ide-mcp-port=[Port for host IDE tools MCP server]:port:'
    '!--ide_mcp_port=[Port for host IDE tools MCP server]:port:'
    '(--include-default-customizations)--include-default-customizations[Include default customizations]'
    '!--is_google_internal[Deprecated: use --is_google3_workspace]'
    '(--log-file --cli_log_file)--log-file=[Override ACP log file path]:log file:_files'
